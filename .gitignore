# ==========================================
# .gitignore customizado para o Bonfire Meet
# Baseado na união do template padrão do Expo (React Native) 
# com proteções essenciais do ecossistema Node.js.
# ==========================================

# ==========================================
# EXPO & REACT NATIVE
# ==========================================
.expo/
dist/
web-build/
expo-env.d.ts
/ios
/android

# ==========================================
# NATIVE (Android / iOS)
# ==========================================
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ==========================================
# DEPENDENCIES & CACHE
# ==========================================
node_modules/
.pnpm-store
.npm
.eslintcache
.stylelintcache

# Yarn v2/v3+
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ==========================================
# ENVIRONMENT VARIABLES
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# LOGS & DIAGNOSTICS
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.metro-health-check*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ==========================================
# TESTING & COVERAGE
# ==========================================
coverage
*.lcov
.nyc_output
lib-cov

# ==========================================
# BUILD & TYPESCRIPT
# ==========================================
*.tsbuildinfo
build/Release
*.tgz

# ==========================================
# SYSTEM FILES
# ==========================================
.DS_Store